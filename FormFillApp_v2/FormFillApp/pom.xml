<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!-- ================================================ -->
  <!--   Project Identity                               -->
  <!-- ================================================ -->
  <groupId>com.sneha.devops</groupId>
  <artifactId>FormFillApp</artifactId>
  <version>2.1-SNAPSHOT</version>
  <packaging>war</packaging>

  <name>FormFillApp</name>
  <description>
    User Registration Web Application with MySQL database support.
    Built as part of DevOps CI/CD pipeline project.
    Pipeline: GitHub → Jenkins → Maven → Tomcat (AWS EC2)
    Future: AWS RDS for database, Docker containerization.
  </description>
  <url>https://github.com/SnehasDevOpsWorld/Project2</url>

  <!-- ================================================ -->
  <!--   SCM - Points to YOUR GitHub repo              -->
  <!-- ================================================ -->
  <scm>
    <connection>scm:git:git@github.com:SnehasDevOpsWorld/Project2.git</connection>
    <developerConnection>scm:git:git@github.com:SnehasDevOpsWorld/Project2.git</developerConnection>
    <url>https://github.com/SnehasDevOpsWorld/Project2</url>
    <tag>HEAD</tag>
  </scm>

  <!-- ================================================ -->
  <!--   Global Properties                             -->
  <!-- ================================================ -->
  <properties>
    <java.version>11</java.version>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Dependency versions - easy to update in one place -->
    <servlet.api.version>5.0.0</servlet.api.version>
    <jsp.api.version>3.0.0</jsp.api.version>
    <jstl.version>2.0.0</jstl.version>
    <mysql.connector.version>8.0.33</mysql.connector.version>
    <junit.version>4.13.2</junit.version>
    <mockito.version>4.11.0</mockito.version>
  </properties>

  <!-- ================================================ -->
  <!--   Dependencies                                  -->
  <!-- ================================================ -->
  <dependencies>

    <!-- Jakarta Servlet API (Tomcat 10+) -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>${servlet.api.version}</version>
      <scope>provided</scope>
      <!-- 'provided' = Tomcat already has this, don't include in WAR -->
    </dependency>

    <!-- Jakarta JSP API (Tomcat 10+) -->
    <dependency>
      <groupId>jakarta.servlet.jsp</groupId>
      <artifactId>jakarta.servlet.jsp-api</artifactId>
      <version>${jsp.api.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- JSTL - for JSP tag libraries -->
    <dependency>
      <groupId>jakarta.servlet.jsp.jstl</groupId>
      <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
      <version>${jstl.version}</version>
    </dependency>

    <!--
      MySQL JDBC Connector
      Currently: used in DBConnection.java (returns null if DB not configured)
      Project 2.1: will connect to AWS RDS MySQL instance
      Project 2.2: will use connection pooling via Tomcat JNDI
    -->
    <dependency>
      <groupId>mysql</groupId>
      <artifactId>mysql-connector-java</artifactId>
      <version>${mysql.connector.version}</version>
      <!-- NOT 'provided' - must be included in WAR -->
    </dependency>

    <!-- JUnit for unit tests -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Mockito for mocking in tests -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <!-- ================================================ -->
  <!--   Build Configuration                           -->
  <!-- ================================================ -->
  <build>

    <!-- Final WAR file name: FormFillApp.war -->
    <finalName>FormFillApp</finalName>

    <plugins>

      <!-- Compiler Plugin - ensures Java 11 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>

      <!-- WAR Plugin - packages the web app -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.3.2</version>
        <configuration>
          <warName>FormFillApp</warName>
          <failOnMissingWebXml>false</failOnMissingWebXml>
        </configuration>
      </plugin>

      <!-- Surefire Plugin - runs unit tests -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.0.0</version>
        <configuration>
          <!-- Build will FAIL if tests fail - good CI/CD practice -->
          <failIfNoTests>false</failIfNoTests>
        </configuration>
      </plugin>

      <!--
        TODO Project 2.1: Add SonarQube plugin here
        <plugin>
          <groupId>org.sonarsource.scanner.maven</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <version>3.9.1.2184</version>
        </plugin>
      -->

    </plugins>
  </build>

</project>
